main.unified-dashboard
    header.hero
        div
            span.eyebrow UNIFIED NEWTON WAREHOUSE LAB
            h1 Warehouse Collision Avoidance
            p Newton Physics · A* · Naive · VO · ORCA
        .engine-state
            span 실제 엔진
            strong {{selected ? 'Newton ' + selected.newton_version : 'Newton 1.7.0'}}
            small CPU · Newton ViewerViser · 동기화된 2D/3D

    nav.workspace-tabs(aria-label="Warehouse Collision Avoidance 메뉴")
        button(type="button", [class.active]="activeView === 'simulation'", (click)="setView('simulation')") 시뮬레이션
        button(type="button", [class.active]="activeView === 'comparison'", (click)="setView('comparison')") 알고리즘 비교
        button(type="button", [class.active]="activeView === 'results'", (click)="setView('results')") 실험 결과
        button(type="button", [class.active]="activeView === 'settings'", (click)="setView('settings')") 환경 설정

        button(type="button", [class.active]="activeView === 'research'", (click)="setView('research')") 연구 분석

    p.status(role="status", [class.busy]="busy") {{message}}
    section.unified-batch
        strong 공통 실험 배치
        button(type="button", [disabled]="busy || controlBusy", (click)="selectUnifiedBatch()") 검증 완료 배치 불러오기
        select(*ngIf="unifiedAvailable.length", aria-label="공통 실험 배치", [ngModel]="selectedBatchId", (ngModelChange)="selectUnifiedBatch($event)", [disabled]="busy || controlBusy")
            option(*ngFor="let id of unifiedAvailable", [value]="id") {{id}}
        p(*ngIf="unifiedBatch") 배치 {{selectedBatchId}} · {{unifiedBatch.completed}}/{{unifiedBatch.total}}조건 · 6맵 × 3알고리즘 × 5시드 · 횡단 작업자4명 · 비교/결과/연구분석이 같은 원본 실행 ID를 사용합니다. {{unifiedBatch.engine_match ? '물리 소스 일치' : '현재 물리 소스가 변경되어 재실험이 필요합니다.'}}
        p(*ngIf="!unifiedBatch") 완료·검증된 공통 배치를 아직 선택하지 않았습니다. 기존 결과는 별도 기록입니다.

    section(*ngIf="activeView === 'simulation'")

        .parallel-launch
            div
                h2 Naive · VO · ORCA 동시 실행
                p 6개 맵 모두 지원 · 3D는 세 장면이 준비된 뒤 함께 출발합니다.
                label 시작 화면
                    select(aria-label="동시 실행 시작 화면", [(ngModel)]="parallelInitialView", [disabled]="controlBusy || parallelBusy")
                        option(value="2d") 2D · 가볍게 시작
                        option(value="3d") 3D · 첫 장면부터 보기
                label
                    input(type="checkbox", [(ngModel)]="crossingPatrol", (ngModelChange)="setEncounter($event ? 'crossing' : 'baseline')", [disabled]="controlBusy || parallelBusy")
                    | 횡단 작업자 사용 (만남 조건을 명시적으로 변경)
            button.primary(type="button", [disabled]="busy || controlBusy || parallelBusy", (click)="startParallel()") {{parallelBusy || controlBusy ? '준비·제어 중…' : 'Start · 3개 알고리즘 함께'}}
        .parallel-comparison(*ngIf="parallelActive")
            .map-buttons(aria-label="동시 비교 맵 선택")
                button(type="button", *ngFor="let item of maps", [class.active]="mapId === item.mapId", [disabled]="controlBusy || parallelBusy", (click)="changeMap(item.mapId)") {{item.mapName}}
            .parallel-toolbar
                button(type="button", [disabled]="parallelBusy || controlBusy", (click)="parallelCommand('pause')") 함께 Pause
                button(type="button", [disabled]="parallelBusy || controlBusy", (click)="parallelCommand('resume')") 함께 Resume
                button(type="button", [disabled]="parallelBusy || controlBusy", (click)="parallelCommand('reset')") 함께 Reset
                button(type="button", [disabled]="parallelBusy || controlBusy", (click)="endParallel()") 동시 비교 종료
                button(type="button", (click)="switchViewer('3d')", [class.active]="viewMode === '3d'") 3D 나란히 보기
                button(type="button", (click)="switchViewer('2d')", [class.active]="viewMode === '2d'") 2D 나란히 보기
            p 비교용 로봇끼리 간섭하지 않도록 동일 초기 조건의 환경을 각각 실행합니다. 작업자도 환경마다 실제 물리 상태로 이동합니다. 화면이 느리면 물리 진행도 함께 기다려 중간 장면이 건너뛰어지지 않도록 합니다.
            .parallel-overview(*ngIf="parallelMeta")
                h3 로봇 3대 경로 요약
                p 같은 물리 시각 {{parallelCurrent(parallelRuns[0])?.t || 0}}s · 작업자는 아래 각 화면에 표시합니다.
                svg([attr.viewBox]="'-1 -1 '+(parallelMeta.width+2)+' '+(parallelMeta.height+2)", role="img", aria-label="세 알고리즘 로봇의 동시 이동 경로")
                    g([attr.transform]="'translate(0 '+parallelMeta.height+') scale(1 -1)'")
                        rect(x="0", y="0", [attr.width]="parallelMeta.width", [attr.height]="parallelMeta.height", fill="#f8fafc", stroke="#94a3b8", stroke-width=".08")
                        g(*ngFor="let shelf of parallelShelves", [attr.transform]="'translate('+shelf.position[0]+' '+shelf.position[1]+') rotate('+shelf.rotation+')'")
                            rect([attr.x]="-shelf.size[0]/2", [attr.y]="-shelf.size[1]/2", [attr.width]="shelf.size[0]", [attr.height]="shelf.size[1]", fill="#94a3b8")
                        circle([attr.cx]="parallelMeta.start[0]", [attr.cy]="parallelMeta.start[1]", r=".5", fill="#14b8a6")
                        circle([attr.cx]="parallelMeta.goal[0]", [attr.cy]="parallelMeta.goal[1]", r=".6", fill="#22c55e")
                        g(*ngFor="let row of parallelRuns")
                            polyline([attr.points]="parallelPath(row)", fill="none", [attr.stroke]="methodColor(row.name)", stroke-width=".13")
                            circle(*ngIf="parallelCurrent(row)", [attr.cx]="parallelCurrent(row).robot[0]", [attr.cy]="parallelCurrent(row).robot[1]", r=".42", [attr.fill]="methodColor(row.name)", stroke="white", stroke-width=".08")
                    g(*ngFor="let row of parallelRuns; let i = index")
                        text(*ngIf="parallelCurrent(row)", [attr.x]="parallelCurrent(row).robot[0]+.6", [attr.y]="parallelMeta.height-parallelCurrent(row).robot[1]+i*.9", font-size=".8", [attr.fill]="methodColor(row.name)") {{row.name}}
                .parallel-legend
                    span(*ngFor="let row of parallelRuns", [style.color]="methodColor(row.name)") ● {{row.name}}
            .parallel-cards
                article.parallel-run(*ngFor="let row of parallelRuns", [attr.data-algorithm]="row.key", [attr.data-map]="row.data?.mapId", [attr.data-frame]="parallelCurrent(row)?.t")
                    header
                        h3([style.color]="methodColor(row.name)") {{row.name}} · R0
                        span {{row.data?.phase || '초기화 중'}}
                    p(role="alert", *ngIf="row.error") {{row.error}}
                    p(*ngIf="viewMode === '3d' && row.data && !row.data.viewer_ready") 3D 장면 준비 중 · 준비가 끝날 때까지 이동을 기다립니다.
                    iframe(*ngIf="row.url && viewMode === '3d'", [src]="row.url", [title]="row.name+' Newton 3D 동시 시뮬레이션'", allow="fullscreen", allowfullscreen="")
                    svg(*ngIf="viewMode === '2d' && row.data && parallelCurrent(row)", [attr.viewBox]="'-1 -1 '+(row.data.width+2)+' '+(row.data.height+2)", role="img", [attr.aria-label]="row.name+' Newton 2D 동시 시뮬레이션'")
                        g([attr.transform]="'translate(0 '+row.data.height+') scale(1 -1)'")
                            rect(x="0", y="0", [attr.width]="row.data.width", [attr.height]="row.data.height", fill="#f8fafc", stroke="#94a3b8", stroke-width=".08")
                            g(*ngFor="let shelf of row.data.shelf_poses", [attr.transform]="'translate('+shelf.position[0]+' '+shelf.position[1]+') rotate('+shelf.rotation+')'")
                                rect([attr.x]="-shelf.size[0]/2", [attr.y]="-shelf.size[1]/2", [attr.width]="shelf.size[0]", [attr.height]="shelf.size[1]", fill="#94a3b8")
                            polyline([attr.points]="parallelPlanned(row)", fill="none", stroke="#94a3b8", stroke-width=".08", stroke-dasharray=".3 .2")
                            polyline([attr.points]="parallelPath(row)", fill="none", [attr.stroke]="methodColor(row.name)", stroke-width=".12")
                            circle([attr.cx]="row.data.goal[0]", [attr.cy]="row.data.goal[1]", r=".5", fill="#22c55e")
                            circle(*ngFor="let body of row.data.bodies", [attr.cx]="parallelCurrent(row).body_q[body.body][0]", [attr.cy]="parallelCurrent(row).body_q[body.body][1]", [attr.r]="body.radius", [attr.fill]="body.id === 'R0' ? methodColor(row.name) : '#ed7923'")
                    p(*ngIf="parallelCurrent(row)") {{parallelCurrent(row).t}}s · 충돌 {{parallelCurrent(row).collisions}} · 안전거리 위반 {{parallelCurrent(row).safety_violations}}
                    p(*ngIf="row.data") {{row.data.worker_count}}명 작업자 · {{row.data.other_robot_count}}대 추가 AMR · {{row.data.encounter_mode}}
                    p(*ngIf="row.data?.status") 결과: {{row.data.status}} · 이동 거리 {{metric(row.data.path_length_m)}}m

        .simulation-layout([hidden]="parallelActive")
            .viewer-card(#viewerPanel="")
                .section-head
                    div
                        span.eyebrow NEWTON LIVE WAREHOUSE
                        h2 {{selected ? selected.algorithm + ' · ' + (selected.mapName || selected.scenario) : '물류창고 시뮬레이션'}}
                    span.badge([class.warn]="current && showCollisions && current.risk") {{current ? current.t + 's' : '대기'}}
                .map-buttons(aria-label="선반 배치 맵")
                    button(type="button", *ngFor="let item of maps", [class.active]="mapId === item.mapId", [attr.aria-pressed]="mapId === item.mapId", [disabled]="busy || controlBusy", [title]="item.description", (click)="changeMap(item.mapId)") {{item.mapName}}
                p.map-description {{mapDescription}}
                .view-toolbar
                    button(type="button", [class.active]="viewMode === '3d'", (click)="switchViewer('3d')") 3D View
                    button(type="button", [class.active]="viewMode === '2d'", (click)="switchViewer('2d')") 2D Top View
                    span.mode-badge {{modeLabel}}
                    button(type="button", (click)="fullscreen()") 전체화면
                .viser-view(*ngIf="viewerUrl && viewMode === '3d'")
                    iframe([src]="viewerUrl", title="Newton ViewerViser 3D Warehouse", allow="fullscreen", allowfullscreen="")
                    p.viewer-help 드래그 회전 · 휠 확대 · 우클릭 이동 | 청록: 로봇 · 주황: 작업자 · 빨강: 현재 위험
                .empty-state(*ngIf="!current")
                    strong 아직 실행 결과가 없습니다.
                    p Start를 누르면 서버의 독립 Python 3.12 환경에서 Newton 강체 시뮬레이션을 실행합니다.
                .warehouse-view(*ngIf="current", [hidden]="viewMode !== '2d'")
                    svg([attr.viewBox]="mapViewBox", role="img", aria-label="Newton 물류창고 상태의 평면 투영")
                        rect(x="0", y="0", [attr.width]="mapWidth", [attr.height]="mapHeight", fill="#f8faf9", stroke="#8ca39e", stroke-width="5")
                        g(*ngIf="selected.scenario !== 'basic'")
                            rect.shelf(*ngFor="let shelf of shelves", [attr.x]="shelf.x*mapScale", [attr.y]="mapHeight-(shelf.y+shelf.h)*mapScale", [attr.width]="shelf.w*mapScale", [attr.height]="shelf.h*mapScale", [attr.transform]="'rotate('+(-shelf.rotation)+' '+(shelf.cx*mapScale)+' '+(mapHeight-shelf.cy*mapScale)+')'")
                        circle(*ngIf="selected.protected_radius_m", [attr.cx]="selected.start[0]*mapScale", [attr.cy]="mapHeight-selected.start[1]*mapScale", [attr.r]="selected.protected_radius_m*mapScale", fill="#14b8a612", stroke="#14b8a6", stroke-dasharray="5 5")
                        circle(*ngIf="selected.protected_radius_m", [attr.cx]="selected.goal[0]*mapScale", [attr.cy]="mapHeight-selected.goal[1]*mapScale", [attr.r]="selected.protected_radius_m*mapScale", fill="#22c55e12", stroke="#22c55e", stroke-dasharray="5 5")
                        polyline.planned(*ngIf="showPath", [attr.points]="plannedPath")
                        polyline.trajectory(*ngIf="showPath", [attr.points]="trajectory", [attr.stroke]="methodColor(selected.algorithm)")
                        circle.goal([attr.cx]="selected.goal[0]*mapScale", [attr.cy]="mapHeight-selected.goal[1]*mapScale", r="10")
                        g.worker(*ngFor="let person of current.workers", [attr.transform]="'translate('+(person[0]*mapScale)+' '+(mapHeight-person[1]*mapScale)+')'")
                            circle(r="7")
                            path(d="M0 7V18M-6 12H6")
                        g.other-robot(*ngFor="let robot of current.robots", [attr.transform]="'translate('+(robot[0]*mapScale)+' '+(mapHeight-robot[1]*mapScale)+')'")
                            rect(x="-8", y="-8", width="16", height="16", rx="2")
                        circle.robot-halo(*ngIf="showCollisions", [class.alert]="current.risk", [attr.cx]="current.robot[0]*mapScale", [attr.cy]="mapHeight-current.robot[1]*mapScale", [attr.r]="(selected.bodies[0].radius+selected.safety_distance_m)*mapScale")
                        g.primary-robot([attr.transform]="'translate('+(current.robot[0]*mapScale)+' '+(mapHeight-current.robot[1]*mapScale)+')'")
                            circle(r="10")
                            text(x="0", y="4", text-anchor="middle") R0
                .playback(*ngIf="current && phase.startsWith('replay')")
                    span 저장 기록
                    button(type="button", [disabled]="controlBusy", (click)="play()") {{phase === 'replay' ? 'Pause' : 'Resume'}}
                    input(type="range", min="0", [max]="selected.frames.length-1", [(ngModel)]="frame", (change)="seek()", [disabled]="controlBusy", aria-label="저장 기록 프레임")
                    strong {{frame + 1}} / {{selected.frames.length}}
                .telemetry(*ngIf="current")
                    div
                        span 위치 X-Y
                        strong {{current.robot[0]}} · {{current.robot[1]}}m
                    div
                        span 속도 X-Y
                        strong {{current.velocity[0]}} · {{current.velocity[1]}}m/s
                    div
                        span 충돌 / 안전거리
                        strong {{current.collisions}} / {{current.safety_violations}}
                    div
                        span 목표 상태
                        strong {{current.reached ? '도달 · 정지' : (selected.status === 'timeout' ? '시간 초과 · 미도달' : '이동 중 · 미도달')}}
                    div
                        span 선택 알고리즘 / 로봇 · 작업자 수
                        strong {{selected.algorithm}} / {{selected.other_robot_count + 1}} · {{selected.worker_count}}
                    div
                        span 목표 속도 X-Y (m/s)
                        strong {{current.target_velocity[0] | number:'1.2-3'}} · {{current.target_velocity[1] | number:'1.2-3'}}
                    div
                        span 알고리즘 / 물리 계산 (ms/step)
                        strong {{current.algorithm_ms | number:'1.2-3'}} / {{current.physics_ms | number:'1.2-3'}}
                    div
                        span 현재 전역 탐색 / 계획 시간
                        strong {{plannerNames[selected.planner || 'astar']}} / {{metric(selected.planning_time_ms)}}ms
                    div
                        span 계획 경로 길이 / 확장 노드
                        strong {{metric(selected.planned_path_length_m)}}m / {{metric(selected.expanded_nodes)}}
                    div
                        span 현재 R0 충돌 위험
                        strong([class.risk-text]="current.risk") {{current.risk ? '위험 접근 / 접촉' : '안전'}}
                .body-table(*ngIf="current")
                    table
                        thead
                            tr
                                th Newton 강체 ID
                                th 종류
                                th 위치 X / Y / Z (m)
                                th 속도 X / Y (m/s)
                        tbody
                            tr(*ngFor="let body of selected.bodies")
                                td {{body.id}}
                                td {{body.kind === 'worker' ? '작업자' : '로봇'}}
                                td {{current.body_q[body.body][0] | number:'1.2-2'}} / {{current.body_q[body.body][1] | number:'1.2-2'}} / {{current.body_q[body.body][2] | number:'1.2-2'}}
                                td {{current.body_qd[body.body][0] | number:'1.2-2'}} / {{current.body_qd[body.body][1] | number:'1.2-2'}}
            aside.control-card
                span.eyebrow RUN CONTROL
                h2 Newton 실행
                label 전역 경로 탐색
                    select(aria-label="전역 경로 탐색", [(ngModel)]="planner", [disabled]="busy || controlBusy")
                        option(value="astar") A*
                        option(value="dijkstra") Dijkstra
                        option(value="rrt") RRT
                label 작업자 모드
                    select(aria-label="작업자 모드", [(ngModel)]="trafficMode", [disabled]="busy || controlBusy")
                        option(value="dynamic") 동적 순찰
                        option(value="static") 정적 작업자
                .algorithm-buttons
                    button(type="button", *ngFor="let item of algorithms", [class.active]="algorithm === item.key", [disabled]="busy || controlBusy", (click)="setAlgorithm(item.key)") {{item.name}}
                button.primary(type="button", [disabled]="busy || controlBusy", (click)="startLive()") {{controlBusy ? '제어 중…' : '선택 알고리즘만 Start'}}
                button(type="button", [disabled]="controlBusy || (phase !== 'running' && phase !== 'replay')", (click)="control('pause')") Pause
                button(type="button", [disabled]="controlBusy || (phase !== 'paused' && phase !== 'replay_paused')", (click)="control('resume')") Resume
                button(type="button", [disabled]="!session || controlBusy", (click)="reset()") Reset
                button(type="button", [class.active]="showPath", (click)="togglePath()") 이동 경로 {{showPath ? 'ON' : 'OFF'}}
                button(type="button", [class.active]="showCollisions", (click)="toggleCollisions()") 충돌 표시 {{showCollisions ? 'ON' : 'OFF'}}
                .engine-note
                    strong {{modeLabel}}
                    p 실시간과 비교는 같은 설정 프레임 한도를 사용합니다. 목표 도달 또는 한도에서 종료하며 미도달은 timeout입니다. Pause는 물리 계산을 정지하고 Reset은 출발 상태를 재생성합니다.
                    p 저장 기록: 완료된 실행의 강체 자세를 재생합니다. 두 뷰는 같은 시간 상태를 공유합니다.
                    p {{selected?.width || 38}} × {{selected?.height || 26}}m · {{selected?.mapName || 'Map 1: Default'}} · START/GOAL 보호 반경 3m
                    p 알고리즘 선택 변경 시 새 물리 실행을 시작합니다. 충돌·안전거리 지표는 주행 로봇 R0 기준입니다.

    section(*ngIf="activeView === 'comparison'", [attr.data-source-batch]="comparisonBatchId || 'interactive'")
        .section-head
            div
                span.eyebrow SAME NEWTON WORLD · SAME SEED
                h2 6개 맵 기준 Naive / VO / ORCA 비교
            div
                label 비교 범위
                    select(aria-label="비교 범위", [(ngModel)]="compareScope", [disabled]="busy || controlBusy")
                        option(value="all") 6개 맵 전체
                        option(value="selected") 선택한 맵만
                button.primary(type="button", [disabled]="busy || controlBusy", (click)="execute('compare')") {{compareScope === 'all' ? '6개 맵 · 18조건 비교 실행' : '선택 맵 · 세 알고리즘 실행'}}
        p.note(*ngIf="encounterMode === 'baseline' && populationMode === 'legacy'") 6개 맵 전체가 기본입니다. 기존 기준 실험은 맵마다 공통 작업자 배치를 사용합니다. 이전 24×16m 시나리오는 전체 비교 시 medium으로 전환합니다.
        p.note(*ngIf="encounterMode !== 'baseline' || populationMode !== 'legacy'") 통제 실험은 각 맵의 실제 경로를 기준으로 만남 위치·출발 지연을 생성합니다. 같은 맵·시드·인구 구성에서 세 알고리즘의 초기 상태가 같으며 실행별 해시와 설정을 보존합니다. 기존 모서리 순찰 배치는 사용하지 않습니다.
        p.note(*ngIf="comparisonBatchId") 원본 배치 {{comparisonBatchId}} · 전체5시드 결과입니다. 새 비교 버튼은 현재 선택 시드의 별도 실행이며 연구 배치를 자동 변경하지 않습니다.
        .algorithm-grid
            article(*ngFor="let item of algorithms", [class.selected]="algorithm === item.key", (click)="setAlgorithm(item.key)")
                strong {{item.name}}
                p {{item.detail}}
        label
            input(type="checkbox", [(ngModel)]="showHistory", (change)="loadSavedResults()", [disabled]="busy")
            | 실행 이력 포함
        button(type="button", [disabled]="busy", (click)="loadSavedResults()") 저장 CSV 불러오기
        p.note {{savedMessage}}
        .chart-grid(*ngIf="comparisonRows.length")
            figure(*ngFor="let map of maps")
                figcaption {{map.mapName}} · 성공한 실행의 도달 시간
                div(*ngFor="let run of mapComparisonRows(map.mapId)")
                    span {{run.algorithm}} · seed {{run.seed}} · {{run.status === 'success' ? metric(run.arrival_time_s ?? run.sim_time_s)+'s' : 'N/A (timeout)'}}
                    div([style.width.%]="arrivalBar(run)", [style.background]="methodColor(run.algorithm)", style="height:14px;min-width:0;margin:4px 0 10px")
        .table-scroll(*ngIf="comparisonRows.length")
